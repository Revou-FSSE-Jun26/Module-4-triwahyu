# Copy to .env for local development. Never commit the real .env file.
FLASK_APP=app:create_app
APP_ENV=development

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production requires both to be at least 32 characters.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-long-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_MINUTES=60

# Local Docker Compose database. On a hosted database use its connection URL (on Vercel prefer the pooled one; add ?sslmode=require if needed).
DATABASE_URL=postgresql://revotask:revotask_local_only@localhost:5432/revotask

# Comma-separated browser origins allowed to call the API (no trailing slash).
CORS_ORIGINS=http://localhost:3000
